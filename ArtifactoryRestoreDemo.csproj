<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- L'audit de vulnérabilités (NU1900) interroge la source NuGet ; un dépôt remote
         Artifactory ne l'expose généralement pas. À réactiver si votre instance le supporte. -->
    <NuGetAudit>false</NuGetAudit>

    <!-- Test de restauration : une version exacte inexistante (NU1603) ou un léger écart
         de version transitive (NU1605) ne doit pas faire échouer le test. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1603;NU1605</WarningsNotAsErrors>
  </PropertyGroup>

  <!-- ============================================================
       Plus de 50 paquets directs (plusieurs centaines avec les
       dépendances transitives) pour valider la restauration via Artifactory.
       Si une version exacte n'existe pas, NuGet prend la plus proche supérieure.
       ============================================================ -->

  <!-- Sérialisation / formats -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="YamlDotNet" Version="16.0.0" />
    <PackageReference Include="CsvHelper" Version="33.0.1" />
    <PackageReference Include="MessagePack" Version="2.5.172" />
    <PackageReference Include="protobuf-net" Version="3.2.30" />
    <PackageReference Include="Google.Protobuf" Version="3.27.2" />
    <PackageReference Include="Markdig" Version="0.37.0" />
  </ItemGroup>

  <!-- Logging -->
  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="8.0.0" />
    <PackageReference Include="NLog" Version="5.3.2" />
  </ItemGroup>

  <!-- Microsoft.Extensions.* -->
  <ItemGroup>
