<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- On vide toutes les sources héritées (nuget.org, sources machine) :
         tout passe par Artifactory. -->
    <clear />

    <!-- IMPORTANT : la clé "artifactory-nuget" sert aussi de nom de source.
         L'URL doit correspondre à celle configurée dans la connexion de service. -->
    <add key="artifactory-nuget"
         value="https://artifactory.exemple.local/artifactory/api/nuget/v3/nuget-remote/index.json"
         protocolVersion="3" />
  </packageSources>

  <!-- Optionnel mais recommandé : garantit que tous les paquets viennent d'Artifactory -->
  <packageSourceMapping>
    <packageSource key="artifactory-nuget">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
